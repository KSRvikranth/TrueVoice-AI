# Copy this file to ".env" and edit. Never commit ".env".
# All values are optional; defaults are shown.

# FFmpeg: leave empty to auto-detect from PATH, or point to ffmpeg(.exe) / its folder.
# Windows example: FFMPEG_PATH=C:\ffmpeg\bin\ffmpeg.exe
FFMPEG_PATH=

# Upload / audio limits
VOXSHIELD_MAX_UPLOAD_MB=25
VOXSHIELD_MIN_AUDIO_SECONDS=0.5
VOXSHIELD_MAX_AUDIO_SECONDS=600
VOXSHIELD_FFMPEG_TIMEOUT=120

# Model locations (relative paths are resolved from the project root)
VOXSHIELD_MODEL_PATH=models/voice_cnn_multisource.pth

# Whisper model size: tiny | base | small | medium
VOXSHIELD_WHISPER_MODEL=base
